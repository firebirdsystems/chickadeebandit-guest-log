{
  "id": "guest-log",
  "contexts": ["household", "shared_space"],
  "name": "Guest Log",
  "version": "1.1.0",
  "description": "A digital sign-in / sign-out sheet for visitors, deliveries, and overnight guests. Members log their own guests; leadership sees the full log and approves overnight stays.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["org", "guests", "sign-in", "front-desk", "visitors", "overnight"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "settings": {"sql": "SELECT key, value FROM app_guest_log__settings WHERE key = 'leadership_group_id'"},
    "visits": {"sql": "SELECT * FROM app_guest_log__visits ORDER BY check_in_at DESC LIMIT 500"},
    "approvals": {"sql": "SELECT a.* FROM app_guest_log__approvals a JOIN app_guest_log__visits v ON v.id = a.visit_id ORDER BY v.check_in_at DESC, a.decided_at ASC LIMIT 1000"}
  },
  "automation_actions": {
    "log_visit": {
      "title": "Sign a guest in",
      "description": "Open a visit record when another app's event fires - a booked amenity slot, an approved contractor, a delivery announced elsewhere.",
      "params": {
        "host_id": {
          "type": "member",
          "label": "Host",
          "required": true
        },
        "guest_name": {
          "type": "text",
          "label": "Guest name",
          "required": true
        },
        "visit_type": {
          "type": "text",
          "label": "Visit type",
          "default": "visitor",
          "options": ["visitor", "delivery", "overnight"]
        },
        "purpose": {
          "type": "text",
          "label": "Purpose",
          "default": ""
        }
      },
      "dedupe": {
        "table": "visits",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "visits",
          "values": {
            "id": "$uuid",
            "guest_name": ":guest_name",
            "visit_type": ":visit_type",
            "purpose": ":purpose",
            "host_id": ":host_id",
            "host_name": "Automation",
            "check_in_at": "$now",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "publishes": ["guest.checked_in", "guest.checked_out"],
  "publish_acls": {
    "guest.checked_in": { "require_role": "member" },
    "guest.checked_out": { "require_role": "member" }
  },
  "db_plaintext_columns": ["visit_type", "status"],
  "row_policies": {
    "visits": {
      "kind": "owner_only",
      "member_column": "host_id",
      "adults_bypass": false,
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "leadership_group_id" }
      ],
      "retain_days": {
        "default": 90,
        "timestamp_column": "check_in_at",
        "dependent_tables": [{ "table": "approvals", "foreign_key": "visit_id" }]
      }
    },
    "approvals": {
      "kind": "inherit_visibility",
      "fk_column": "visit_id",
      "parent_table": "visits",
      "writer_column": "decided_by",
      "insert_privileged_only": true,
      "endpoint_writes_only": true
    },
    "settings": {
      "kind": "app_config"
    }
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["leadership_group_id"]
  },
  "append_only_records": {
    "approvals": {
      "table": "approvals",
      "parent_table": "visits",
      "parent_fk_column": "visit_id",
      "allowed_columns": ["visit_id", "decision", "note"],
      "writer_column": "decided_by",
      "created_at_column": "decided_at",
      "write_acl": {
        "require_group_setting": { "settings_table": "settings", "settings_key": "leadership_group_id" }
      },
      "allowed_values": {
        "decision": ["approved", "denied"]
      },
      "max_text_lengths": {
        "visit_id": 120,
        "decision": 20,
        "note": 1000
      }
    }
  },
  "member_references": {
    "visits": {
      "column": "host_id",
      "on_removed": "delete",
      "dependent_tables": [
        {
          "table": "approvals",
          "foreign_key": "visit_id"
        }
      ]
    },
    "approvals": { "column": "decided_by", "on_removed": "keep" }
  },
  "delete_cascades": {
    "visits": [
      { "table": "approvals", "foreign_key": "visit_id" }
    ]
  },
  "kiosk": "never",
  "nav": { "label": "Guest Log" },
  "agenda": {
    "kind": "event",
    "label": "Guest",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, guest_name AS title, visit_type AS subtitle, host_id AS member_id, expected_out_at AS when_at FROM app_guest_log__visits WHERE check_out_at IS NULL AND expected_out_at IS NOT NULL AND substr(expected_out_at, 1, 10) = :today LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_guest_log__visits WHERE check_out_at IS NULL LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "on site", "severity": "info" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "📖",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["recent_visits", "checked_in"]
  }
}
