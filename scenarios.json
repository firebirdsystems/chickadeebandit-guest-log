{
  "scenarios": [
    {
      "name": "a host's visit log is private even from other adults",
      "members": { "host": "adult", "other": "adult" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_log__visits (id, guest_name, visit_type, host_id, host_name, status, check_in_at, created_at, updated_at) VALUES (?, ?, 'visitor', ?, ?, 'checked_in', ?, ?, ?)",
          "params": ["v1", "Aunt Carol", "{{host}}", "Host", "2026-01-01T10:00:00Z", "2026-01-01T10:00:00Z", "2026-01-01T10:00:00Z"]
        },
        {
          "action": "db",
          "as": "host",
          "sql": "SELECT id, guest_name FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1 }
        },
        {
          "action": "db",
          "as": "other",
          "sql": "SELECT id, guest_name FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 0 }
        }
      ]
    },
    {
      "name": "a child's visit log is private to the child and cannot touch an adult's visits",
      "members": { "kid": "child", "parent": "adult" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_log__visits (id, guest_name, visit_type, host_id, host_name, status, check_in_at, created_at, updated_at) VALUES (?, ?, 'visitor', ?, ?, 'checked_in', ?, ?, ?)",
          "params": [
            "vp",
            "Plumber",
            "{{parent}}",
            "Parent",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "INSERT INTO app_guest_log__visits (id, guest_name, visit_type, host_id, host_name, status, check_in_at, created_at, updated_at) VALUES (?, ?, 'visitor', ?, ?, 'checked_in', ?, ?, ?)",
          "params": [
            "vk",
            "Best friend",
            "{{kid}}",
            "Kid",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z"
          ],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id, host_id FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "vk", "host_id": "scn-kid" }] }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "SELECT id FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "vp" }] }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "UPDATE app_guest_log__visits SET status = 'checked_out' WHERE id = 'vp'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "DELETE FROM app_guest_log__visits WHERE id = 'vp'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "SELECT id, status FROM app_guest_log__visits WHERE id = 'vp'",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "status": "checked_in" }] }
        }
      ]
    },
    {
      "name": "a child cannot record a visit approval",
      "members": { "kid": "child" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_log__visits (id, guest_name, visit_type, host_id, host_name, status, check_in_at, created_at, updated_at) VALUES (?, ?, 'visitor', ?, ?, 'checked_in', ?, ?, ?)",
          "params": [
            "vk",
            "Best friend",
            "{{kid}}",
            "Kid",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "INSERT INTO app_guest_log__approvals (id, visit_id, decision, note, decided_by, decided_at) VALUES ('ap1', 'vk', 'approved', '', ?, ?)",
          "params": ["{{kid}}", "2026-01-01T00:00:00Z"],
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id FROM app_guest_log__approvals",
          "expect": { "status": 200, "rowCount": 0 }
        }
      ]
    },
    {
      "name": "a leadership-group adult sees and checks out another host's visit; a plain adult outside the group cannot",
      "members": { "leader": "adult", "host": "adult", "neighbor": "adult" },
      "steps": [
        { "action": "seedGroup", "group": "leaders", "name": "Leadership", "members": ["leader"] },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_log__settings (key, value) VALUES ('leadership_group_id', ?)",
          "params": ["{{group:leaders}}"]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_log__visits (id, guest_name, visit_type, host_id, host_name, status, check_in_at, created_at, updated_at) VALUES ('v1', 'Aunt Carol', 'visitor', ?, 'Host', 'checked_in', '2026-01-01T10:00:00Z', '2026-01-01T10:00:00Z', '2026-01-01T10:00:00Z')",
          "params": ["{{host}}"]
        },
        {
          "action": "db",
          "as": "neighbor",
          "sql": "SELECT id FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 0 }
        },
        {
          "action": "db",
          "as": "neighbor",
          "sql": "UPDATE app_guest_log__visits SET status = 'checked_out' WHERE id = 'v1'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "host",
          "sql": "SELECT id, status FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "v1", "status": "checked_in" }] }
        },
        {
          "action": "db",
          "as": "leader",
          "sql": "SELECT id, host_id FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "v1", "host_id": "scn-host" }] }
        },
        {
          "action": "db",
          "as": "leader",
          "sql": "UPDATE app_guest_log__visits SET status = 'checked_out', check_out_at = '2026-01-01T12:00:00Z' WHERE id = 'v1'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "host",
          "sql": "SELECT id, status FROM app_guest_log__visits",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "v1", "status": "checked_out" }] }
        }
      ]
    }
  ]
}
